#!/usr/bin/env python3
"""Strict mock CLI; never invokes herdr or an AI executable."""
import fcntl
import json
import os
from pathlib import Path
import signal
import sys
import termios
import tty

root = Path(os.environ["SIDEKICK_HERDR_FIXTURE"])
original = sys.argv[1:]
with (root / "calls").open("a") as stream:
    stream.write(json.dumps(original) + "\n")
state = json.loads((root / "state.json").read_text())
args = original[:]
scoped = args[:1] == ["--session"]


def forbidden(reason):
    with (root / "violations").open("a") as stream:
        stream.write(reason + ": " + json.dumps(original) + "\n")
    print(reason, file=sys.stderr)
    sys.exit(97)


def reply(value):
    if state.get("error_null"):
        value["error"] = None
    print(json.dumps(value))


if scoped:
    if len(args) < 3 or args[1] != state.get("session_name", "poc"):
        forbidden("wrong server")
    args = args[2:]
pinned_read = not scoped and args in (["status", "server", "--json"], ["api", "snapshot"])
if pinned_read:
    if "HERDR_SESSION" in os.environ or not os.environ.get("HERDR_SOCKET_PATH"):
        forbidden("terminal observation was not socket-pinned")
    if os.environ["HERDR_SOCKET_PATH"] != state["socket"]:
        print("mock socket unavailable", file=sys.stderr)
        sys.exit(1)
if args == ["--version"] and not scoped:
    print(state.get("client_version_output", "herdr 0.9.5"))
elif args == ["session", "list", "--json"] and not scoped:
    reply({"sessions": state["sessions"]})
elif args == ["status", "server", "--json"] and (scoped or pinned_read):
    reply({"socket": state["socket"], "running": state.get("server_running", True),
           "version": state["snapshot"]["version"], "protocol": state["snapshot"].get("protocol", 22)})
elif args == ["api", "snapshot"] and (scoped or pinned_read):
    if state.get("fail_snapshot"):
        if not state.get("empty_error"):
            print("synthetic snapshot access denied", file=sys.stderr)
        sys.exit(3)
    if state.get("malformed_snapshot"):
        print("{not-json")
    else:
        reply({"result": {"snapshot": state["snapshot"]}})
elif len(args) == 3 and args[:2] == ["agent", "get"] and scoped:
    agents = [a for a in state["snapshot"]["agents"] if a["pane_id"] == args[2]]
    reply({"result": {"agent": agents[0]}} if agents else {"error": {"code": "not_found"}})
elif len(args) == 4 and args[:3] == ["pane", "process-info", "--pane"] and scoped:
    info = state.get("processes", {}).get(args[3], {})
    reply({"result": {"process_info": {
        "foreground_process_group_id": info.get("group", state.get("process_group")),
        "shell_pid": info.get("shell_pid", state.get("shell_pid", 1))}}})
elif len(args) == 3 and (args[:2] == ["agent", "attach"] and scoped or args[:2] == ["terminal", "attach"] and not scoped):
    if args[0] == "terminal":
        if os.environ.get("HERDR_SOCKET_PATH") != state["socket"] or "HERDR_SESSION" in os.environ:
            forbidden("attachment was not socket-pinned")
        matches = [a for a in state["snapshot"]["agents"] if a["terminal_id"] == args[2]]
        if len(matches) != 1:
            forbidden("unknown terminal")
        pane = matches[0]["pane_id"]
    else:
        pane = args[2]
    lock = (root / (pane.replace(":", "_") + ".lock")).open("w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print("mock input ownership conflict", file=sys.stderr)
        sys.exit(23)
    (root / "owner.pid").write_text(str(os.getpid()))
    old = termios.tcgetattr(0)
    tty.setraw(0)

    def size(*_):
        with (root / "sizes").open("a") as stream:
            stream.write(str(os.get_terminal_size(0)) + "\n")

    signal.signal(signal.SIGWINCH, size)
    size()
    os.write(1, b"MOCK ATTACHED\r\n")
    try:
        while True:
            data = os.read(0, 4096)
            if not data:
                break
            with (root / "input").open("ab") as stream:
                stream.write(data)
            os.write(1, data)
    finally:
        termios.tcsetattr(0, termios.TCSANOW, old)
else:
    forbidden("unsupported or mutating command")
